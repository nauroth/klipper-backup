dir_pin = !PB7
enable_pin = !PE0
microsteps = 16
rotation_distance = 8
endstop_pin = ^PF2
position_endstop = 0
position_max = 270
position_min = -5.0
homing_speed = 8
second_homing_speed = 3
homing_retract_dist = 3

[heater_bed]
