voltage = 24

[tmc2209 stepper_z]
uart_pin = PB5
interpolate = true
run_current = 0.976
sense_resistor = 0.110

[stepper_z1]
step_pin = PG13
dir_pin = !PG12
enable_pin = !PG15
rotation_distance = 40
microsteps = 256
full_steps_per_rotation = 400
gear_ratio = 80:16

[autotune_tmc stepper_z1]
motor = ldo-42sth48-2504mac
tuning_goal = silent
voltage = 24

[tmc2209 stepper_z1]
uart_pin = PG14
interpolate = true
run_current = 0.976
sense_resistor = 0.110

[stepper_z2]
step_pin = PG9
dir_pin = PD7
enable_pin = !PG11
rotation_distance = 40
microsteps = 256
full_steps_per_rotation = 400
gear_ratio = 80:16

[autotune_tmc stepper_z2]
motor = ldo-42sth48-2504mac
tuning_goal = silent
voltage = 24

[tmc2209 stepper_z2]
uart_pin = PG10
interpolate = true
run_current = 0.976
sense_resistor = 0.110

[stepper_z3]
step_pin = PD4
dir_pin = !PD3
enable_pin = !PD6
rotation_distance = 40
microsteps = 256
full_steps_per_rotation = 400
gear_ratio = 80:16

[autotune_tmc stepper_z3]
motor = ldo-42sth48-2504mac
tuning_goal = silent
voltage = 24

[tmc2209 stepper_z3]
uart_pin = PD5
interpolate = true
run_current = 0.976
sense_resistor = 0.110

[autotune_tmc extruder]
motor = ldo-36sth20-1004ahg
tuning_goal = auto
voltage = 24

[heater_bed]
heater_pin = PF5
sensor_pin = PB0
sensor_type = Generic 3950
control = watermark
min_temp = 0
max_temp = 130

[board_pins]
aliases = 
	
	EXP1_1=PE7, EXP1_2=PG1,
	EXP1_3=PG0, EXP1_4=PF15,
	EXP1_5=PF14, EXP1_6=PF13,
	EXP1_7=PF12, EXP1_8=PF11,
	EXP1_9=<GND>, EXP1_10=<5V>,
	
	
	EXP2_1=PE13, EXP2_2=PE12,
	EXP2_3=PE15, EXP2_4=PE11,
	EXP2_5=PE10, EXP2_6=PE14,
	EXP2_7=PE8, EXP2_8=<RST>,
	EXP2_9=<GND>, EXP2_10=<NC>

[virtual_sdcard]
path = ~/printer_data/gcodes
on_error_gcode = CANCEL_PRINT

[pause_resume]

[display_status]

