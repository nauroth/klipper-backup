spi_software_miso_pin = EBBCan:PB2
axes_map = x,y,z

[extruder]
step_pin = EBBCan:PD0
dir_pin = !EBBCan:PD1
enable_pin = !EBBCan:PD2
microsteps = 16
rotation_distance = 33.500
nozzle_diameter = 0.400
