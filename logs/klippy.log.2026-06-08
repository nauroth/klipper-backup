dir_pin = PE1
enable_pin = !PE4
rotation_distance = 40
microsteps = 64
full_steps_per_rotation = 200
endstop_pin = ^PF3
position_min = 0
position_max = 259
position_endstop = 259
homing_speed = 30
homing_retract_dist = 30
homing_retract_speed = 30
second_homing_speed = 30
homing_positive_dir = true

[autotune_tmc stepper_y]
